name: Build sys-clk artifacts - 20251118

on:
  push:
    branches: [ "develop" ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    name: Build and package
    runs-on: ubuntu-latest
    container: devkitpro/devkita64:latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Update system packages
        run: |
          sudo apt-get update || true
          sudo apt-get upgrade -y git build-essential
        shell: bash

      - name: Install latest libnx
        run: |
          git config --global --add safe.directory "*"
          git clone --recurse-submodules https://github.com/switchbrew/libnx.git
          cd libnx
          make install -j$(nproc)
        shell: bash

      - name: Set environment variables
        run: |
          echo "DEVKITPRO=/opt/devkitpro" >> $GITHUB_ENV
          echo "DEVKITA64=/opt/devkitpro/devkitA64" >> $GITHUB_ENV

      - name: Build overlay
        run: |
          git config --global --add safe.directory `pwd`
          cd overlay
          make -j$(nproc)
          cd ..
        shell: bash

      - name: Package language files
        run: |
          LANG_SRC_DIR="overlay/lang"
          if [ -d "$LANG_SRC_DIR" ] && [ "$(ls -A "$LANG_SRC_DIR")" ]; then
            cd "$LANG_SRC_DIR" && zip -r ../lang.zip ./*
          else
            zip -r lang.zip -q /dev/null
            mv lang.zip overlay/
          fi

      - name: Get version from overlay/Makefile
        run: |
          RAW_VERSION=$(awk '/^APP_VERSION[[:space:]]*:=/ {
            gsub(/^APP_VERSION[[:space:]]*:=/, "");
            gsub(/[[:space:]]+$/, "");
            print $0
          }' overlay/Makefile)
          echo "TAG=$RAW_VERSION" >> $GITHUB_ENV

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: sys-clk-${{ env.TAG }}
          path: |
            overlay/out/sys-clk-overlay.ovl
            overlay/lang.zip

      - name: Release
        if: github.event_name == 'push' && github.ref == 'refs/heads/develop'
        uses: softprops/action-gh-release@v2
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          files: |
            overlay/out/sys-clk-overlay.ovl
            overlay/lang.zip
          tag_name: ${{ env.TAG }}
          name: sys-clk ${{ env.TAG }}
          body: "sys-clk ${{ env.TAG }} 多语言版 支持EOS"
          generate_release_notes: true
